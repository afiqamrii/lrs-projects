# Phase 9 confidential Google Web client (server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/settings/mailbox/google/callback

# Keep true throughout any isolated restore; never run a restored outbox blindly.
LRS_RESTORE_LOCKDOWN=false
